# Copy to .env for local runs (go run ./cmd/server). All values default to localhost.

AUTH_HTTP_ADDR=:8001
AUTH_DB_URL=postgres://auth_svc:auth_pw@localhost:5432/marketplace?search_path=auth&sslmode=disable
AUTH_REDIS_ADDR=localhost:6379
AUTH_REDIS_PASSWORD=
AUTH_PRIVATE_KEY_PATH=../../keys/jwt_private.pem
AUTH_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=7
AUTH_JWT_ISSUER=marketplace-auth
