# Copy to .env for local runs (npm run start:dev). All values default to localhost.
CHAT_HTTP_PORT=8006
CHAT_DB_URL=postgres://chat_svc:chat_pw@localhost:5432/marketplace
CHAT_REDIS_URL=redis://localhost:6379
CHAT_RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=marketplace.events
# Path to the Auth Service public key (relative to this service dir).
CHAT_JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
CHAT_JWT_ISSUER=marketplace-auth
CHAT_CORS_ORIGINS=*
