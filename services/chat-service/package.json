{
  "name": "chat-service",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time 1-1 buyer<->seller chat service (Express + Socket.io) for the shopoo marketplace",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/db/migrations',{recursive:true});for(const f of fs.readdirSync('src/db/migrations'))fs.copyFileSync('src/db/migrations/'+f,'dist/db/migrations/'+f)\"",
    "start": "node dist/server.js",
    "start:dev": "ts-node src/server.ts",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
