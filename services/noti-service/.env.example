# Copy to .env for local runs (go run ./cmd/server). All values default to localhost.

NOTI_HTTP_ADDR=:8003
NOTI_DB_URL=postgres://noti_svc:noti_pw@localhost:5432/marketplace?search_path=noti&sslmode=disable
NOTI_REDIS_ADDR=localhost:6379
NOTI_REDIS_PASSWORD=
NOTI_RABBITMQ_URL=amqp://guest:guest@localhost:5672
NOTI_RABBITMQ_EXCHANGE=marketplace.events
NOTI_JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
NOTI_JWT_ISSUER=marketplace-auth

# Path to a Firebase service-account JSON file. Leave UNSET to run push in
# logging/no-op mode (handy for local dev without Firebase credentials).
NOTI_FCM_CREDENTIALS_FILE=

# How long (minutes) a processed eventId is remembered in Redis for idempotency.
NOTI_PROCESSED_TTL_MIN=1440
