# Copy to .env for local runs (go run ./cmd/server). All values default to localhost.

MEDIA_HTTP_ADDR=:8002
MEDIA_DB_URL=postgres://media_svc:media_pw@localhost:5432/marketplace?search_path=media&sslmode=disable

# JWT: verify access tokens with the Auth Service public key ONLY.
MEDIA_JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
MEDIA_JWT_ISSUER=marketplace-auth

# MinIO / S3-compatible object storage.
MEDIA_S3_ENDPOINT=localhost:9000
MEDIA_S3_ACCESS_KEY=minioadmin
MEDIA_S3_SECRET_KEY=minioadmin
MEDIA_S3_BUCKET=media
MEDIA_S3_USE_SSL=false
# Base URL clients use to fetch objects (path-style: <endpoint>/<bucket>).
MEDIA_S3_PUBLIC_BASE_URL=http://localhost:9000/media

# Upload limits / image processing.
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_RESIZE_WORKERS=4
