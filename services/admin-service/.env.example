# Copy to .env for local runs (npm run start:dev). All values default to localhost.
ADMIN_HTTP_PORT=8005
ADMIN_DB_URL=postgres://admin_svc:admin_pw@localhost:5432/marketplace
ADMIN_RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=marketplace.events
ADMIN_JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
ADMIN_JWT_ISSUER=marketplace-auth
ADMIN_LISTING_BASE_URL=http://localhost:8004
ADMIN_AUTH_BASE_URL=http://localhost:8001
ADMIN_CORS_ORIGINS=*
