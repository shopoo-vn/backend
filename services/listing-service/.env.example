# Copy to .env for local runs (npm run start:dev). All values default to localhost.
LISTING_HTTP_PORT=8004
LISTING_DB_URL=postgres://listing_svc:listing_pw@localhost:5432/marketplace
LISTING_RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=marketplace.events
LISTING_JWT_PUBLIC_KEY_PATH=../../keys/jwt_public.pem
LISTING_JWT_ISSUER=marketplace-auth
LISTING_CORS_ORIGINS=*
