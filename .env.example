# Copy to .env for local docker-compose overrides. Defaults are baked into
# docker-compose.yml, so .env is optional in dev.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketplace

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
